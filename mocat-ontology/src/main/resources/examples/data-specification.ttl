@prefix omg-schema: <https://data.omgeving.vlaanderen.be/id/schema/> .
@prefix omg-shacl:  <https://data.omgeving.vlaanderen.be/id/shacl/> .
@prefix dcterms:    <http://purl.org/dc/terms/> .
@prefix rdf:        <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:       <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:        <http://www.w3.org/2002/07/owl#> .
@prefix sh:         <http://www.w3.org/ns/shacl#> .
@prefix xsd:        <http://www.w3.org/2001/XMLSchema#> .
@prefix geo:        <http://www.opengis.net/ont/geosparql#> .
@prefix p-plan:     <http://purl.org/net/p-plan#> .
@prefix ex:         <http://example.org/> .

# ── Prefix declarations for SHACL-SPARQL ─────────────────────────────────────
# SHACL-SPARQL does not reuse the Turtle @prefix declarations, so the prefixes
# used inside the queries are declared explicitly here.

<https://data.omgeving.vlaanderen.be/id/shacl/>
    a          owl:Ontology ;
    sh:declare [ sh:prefix    "ex" ;
                 sh:namespace "http://example.org/"^^xsd:anyURI ] ;
    sh:declare [ sh:prefix    "rdf" ;
                 sh:namespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#"^^xsd:anyURI ] .

# ── DataSpecification (p-plan:Variable) ──────────────────────────────────────

omg-schema:TransportNetworkSchema
    a                   p-plan:Variable ;
    dcterms:title       "Transport Network schema"@en ;
    dcterms:description "A transport network consists of nodes (vertices) and edges."@en ;
    dcterms:hasPart     omg-shacl:TransportNodeShape, omg-shacl:TransportEdgeShape, omg-shacl:TurnMovementShape,
                        omg-shacl:TransportZoneShape, omg-shacl:OriginDestinationDemandShape .


omg-schema:RunConfigurationSchema
    a                   p-plan:Variable ;
    dcterms:title       "Run configuration schema"@en ;
    dcterms:description "The schema of a run configuration, that is conceived as key-value pairs."@en ;
    dcterms:hasPart     omg-shacl:RunConfigurationShape .


omg-schema:SimulationOutputSchema
    a                   p-plan:Variable ;
    dcterms:title       "Simulation output schema"@en ;
    dcterms:description "The schema of the output dataset produced by the Traffic-Scout simulation model."@en ;
    dcterms:hasPart     omg-shacl:SimulationOutputShape .

# ── NodeShapes (sh:NodeShape) ─────────────────────────────────────────────────

omg-shacl:TransportNodeShape
    a                   sh:NodeShape ;
    rdfs:label          "Transport node Schema"@en ;
    dcterms:description "A node (vertex) in the transport network."@en ;
    sh:targetClass      ex:TransportNode ;
    sh:property         [ sh:path        ex:geom ;
                          sh:name        "geometry"@en ;
                          sh:description "Point geometry of the node (WKT, optionally prefixed with a CRS IRI)."@en ;
                          sh:datatype    geo:wktLiteral ;
                          sh:pattern     "^\\s*(<[^>]+>\\s*)?POINT\\s*(Z|M|ZM)?\\s*\\(" ;
                          sh:flags       "i" ;
                          sh:minCount    1 ;
                          sh:maxCount    1 ;
                          sh:message     "A transport node must have exactly one (point) geometry."@en ; ] ;
    sh:sparql           [ sh:message  "Each transport node must be connected to at least one transport edge."@en ;
                          sh:prefixes <https://data.omgeving.vlaanderen.be/id/shacl/> ;
                          sh:select   """
            SELECT $this
            WHERE {
                FILTER NOT EXISTS { ?edge ex:fromNode $this . }
                FILTER NOT EXISTS { ?edge ex:toNode $this . }
            }
        """ ; ] .

omg-shacl:TransportEdgeShape
    a                   sh:NodeShape ;
    rdfs:label          "Transport Edge Schema"@en ;
    dcterms:description "An edge (link) in the transport network."@en ;
    sh:targetClass      ex:TransportEdge ;
    sh:property         [ sh:path         ex:length ;
                          sh:name         "length"@en ;
                          sh:description  "Length of the edge in metres."@en ;
                          sh:datatype     xsd:double ;
                          sh:minExclusive 0 ;
                          sh:minCount     1 ;
                          sh:maxCount     1 ;
                          sh:message      "A transport edge must have exactly one length property, greater than 0."@en ; ] ;
    sh:property         [ sh:path        ex:fromNode ;
                          sh:name        "fromNode"@en ;
                          sh:description "Start node of the edge."@en ;
                          sh:class       ex:TransportNode ;
                          sh:nodeKind    sh:IRI ;
                          sh:minCount    1 ;
                          sh:maxCount    1 ;
                          sh:message     "A transport edge must have exactly one fromNode."@en ; ] ;
    sh:property         [ sh:path        ex:toNode ;
                          sh:name        "toNode"@en ;
                          sh:description "End node of the edge."@en ;
                          sh:class       ex:TransportNode ;
                          sh:nodeKind    sh:BlankNodeOrIRI ;
                          sh:disjoint    ex:fromNode ;
                          sh:severity    sh:Warning ;
                          sh:minCount    1 ;
                          sh:maxCount    1 ;
                          sh:message     "A transport edge must have exactly one toNode, normally different from its fromNode (loops are reported as a warning)."@en ; ] ;
    sh:property         [ sh:path         ex:legalSpeedLimit ;
                          sh:name         "speed limit"@en ;
                          sh:description  "Legal speed limit."@en ;
                          sh:datatype     xsd:double ;
                          sh:minInclusive 0 ;
                          sh:minCount     1 ;
                          sh:maxCount     1 ;
                          sh:message      "A transport edge must have exactly one speed limit property, not negative."@en ; ] ;
    sh:property         [ sh:path        ex:carAccessible ;
                          sh:name        "carAccessible"@en ;
                          sh:description "Whether the edge is car accessible."@en ;
                          sh:datatype    xsd:boolean ;
                          sh:minCount    1 ;
                          sh:maxCount    1 ;
                          sh:message     "A transport edge must have exactly one carAccessible property."@en ; ] ;
    sh:property         [ sh:path        ex:truckAccessible ;
                          sh:name        "truckAccessible"@en ;
                          sh:description "Whether the edge is truck accessible."@en ;
                          sh:datatype    xsd:boolean ;
                          sh:minCount    1 ;
                          sh:maxCount    1 ;
                          sh:message     "A transport edge must have exactly one truckAccessible property."@en ; ] ;
    sh:property         [ sh:path        ex:bicycleAccessible ;
                          sh:name        "bicycleAccessible"@en ;
                          sh:description "Whether the edge is bicycle accessible."@en ;
                          sh:datatype    xsd:boolean ;
                          sh:minCount    1 ;
                          sh:maxCount    1 ;
                          sh:message     "A transport edge must have exactly one bicycleAccessible property."@en ; ] ;
    sh:property         [ sh:path        ex:geom ;
                          sh:name        "geometry"@en ;
                          sh:description "Linestring geometry of the edge (WKT, optionally prefixed with a CRS IRI)."@en ;
                          sh:datatype    geo:wktLiteral ;
                          sh:pattern     "^\\s*(<[^>]+>\\s*)?LINESTRING\\s*(Z|M|ZM)?\\s*\\(" ;
                          sh:flags       "i" ;
                          sh:minCount    1 ;
                          sh:maxCount    1 ;
                          sh:message     "A transport edge must have exactly one (linestring) geometry."@en ; ] .

omg-shacl:TurnMovementShape
    a              sh:NodeShape ;
    rdfs:label     "Turn Movement Schema"@en ;
    dcterms:description
                   "An indication that it is possible to make a turn, defined by 3 consecutive transport nodes, in the network."@en ;
    sh:targetClass ex:TurnMovement ;
    sh:property    [ sh:path        ex:fromNode ;
                     sh:name        "fromNode"@en ;
                     sh:description "Start node of the turn movement."@en ;
                     sh:class       ex:TransportNode ;
                     sh:nodeKind    sh:BlankNodeOrIRI ;
                     sh:minCount    1 ;
                     sh:maxCount    1 ;
                     sh:message     "A turn movement must have exactly one fromNode."@en ; ] ;
    sh:property    [ sh:path        ex:viaNode ;
                     sh:name        "viaNode"@en ;
                     sh:description "Node via which the turn movement passes."@en ;
                     sh:class       ex:TransportNode ;
                     sh:nodeKind    sh:BlankNodeOrIRI ;
                     sh:minCount    1 ;
                     sh:maxCount    1 ;
                     sh:message     "A turn movement must have exactly one viaNode."@en ; ] ;
    sh:property    [ sh:path        ex:toNode ;
                     sh:name        "toNode"@en ;
                     sh:description "End node of the turn movement."@en ;
                     sh:class       ex:TransportNode ;
                     sh:nodeKind    sh:BlankNodeOrIRI ;
                     sh:disjoint    ex:fromNode ;
                     sh:severity    sh:Warning ;
                     sh:minCount    1 ;
                     sh:maxCount    1 ;
                     sh:message     "A turn movement must have exactly one toNode; a toNode equal to the fromNode is a U-turn (reported as a warning)."@en ; ] ;
    sh:property    [ sh:path     ex:geom ;
                     sh:name     "geometry"@en ;
                     sh:description
                                 "Linestring geometry of the turn movement (WKT, optionally prefixed with a CRS IRI)."@en ;
                     sh:datatype geo:wktLiteral ;
                     sh:pattern  "^\\s*(<[^>]+>\\s*)?LINESTRING\\s*(Z|M|ZM)?\\s*\\(" ;
                     sh:flags    "i" ;
                     sh:minCount 1 ;
                     sh:maxCount 1 ;
                     sh:message  "A turn movement must have exactly one (linestring) geometry."@en ; ] ;
    sh:sparql      [ sh:message  "The fromNode-viaNode must correspond to an edge in the transport network."@en ;
                     sh:prefixes <https://data.omgeving.vlaanderen.be/id/shacl/> ;
                     sh:select   """
            SELECT $this ?fromNode ?viaNode
            WHERE {
                $this ex:fromNode ?fromNode .
                $this ex:viaNode  ?viaNode .
                FILTER NOT EXISTS { ?edge a ex:TransportEdge ;
                                          ex:fromNode ?fromNode ;
                                          ex:toNode   ?viaNode . }
            }
        """ ; ] ;
    sh:sparql      [ sh:message  "The viaNode-toNode must correspond to an edge in the transport network."@en ;
                     sh:prefixes <https://data.omgeving.vlaanderen.be/id/shacl/> ;
                     sh:select   """
            SELECT $this ?viaNode ?toNode
            WHERE {
                $this ex:viaNode ?viaNode .
                $this ex:toNode  ?toNode .
                FILTER NOT EXISTS { ?edge a ex:TransportEdge ;
                                          ex:fromNode ?viaNode ;
                                          ex:toNode   ?toNode . }
            }
        """ ; ] .

omg-shacl:TransportZoneShape
    a              sh:NodeShape ;
    rdfs:label     "Transport zone"@en ;
    dcterms:description
                   "The spatial limits of the transport zone for which the simulation model can produce valid results."@en ;
    sh:targetClass ex:TransportZone ;
    sh:property    [ sh:path     ex:geom ;
                     sh:name     "geometry"@en ;
                     sh:description
                                 "Polygon geometry of the transport zone (WKT, optionally prefixed with a CRS IRI)."@en ;
                     sh:datatype geo:wktLiteral ;
                     sh:pattern  "^\\s*(<[^>]+>\\s*)?(MULTI)?POLYGON\\s*(Z|M|ZM)?\\s*\\(" ;
                     sh:flags    "i" ;
                     sh:minCount 1 ;
                     sh:maxCount 1 ;
                     sh:message  "A transport zone must have exactly one (polygon) geometry."@en ; ] .


omg-shacl:OriginDestinationDemandShape
    a              sh:NodeShape ;
    rdfs:label     "Origin-destination demand"@en ;
    dcterms:description
                   "The demand for travel between an origin and a destination transport zone, for a transport mode and hour of the day."@en ;
    sh:targetClass ex:OriginDestinationDemand ;
    sh:property    [ sh:path        ex:origin ;
                     sh:name        "origin"@en ;
                     sh:description "The transport zone where the trips start."@en ;
                     sh:class       ex:TransportZone ;
                     sh:nodeKind    sh:BlankNodeOrIRI ;
                     sh:minCount    1 ;
                     sh:maxCount    1 ;
                     sh:message     "An origin-destination demand must have exactly one origin transport zone."@en ; ] ;
    sh:property    [ sh:path        ex:destination ;
                     sh:name        "destination"@en ;
                     sh:description "The transport zone where the trips end."@en ;
                     sh:class       ex:TransportZone ;
                     sh:nodeKind    sh:BlankNodeOrIRI ;
                     sh:minCount    1 ;
                     sh:maxCount    1 ;
                     sh:message     "An origin-destination demand must have exactly one destination transport zone."@en ; ] ;
    sh:property    [ sh:path        ex:transportMode ;
                     sh:name        "transport mode"@en ;
                     sh:description "The transport mode (matches the edge accessibility flags)."@en ;
                     sh:datatype    xsd:string ;
                     sh:in          ( "car" "truck" "bicycle" ) ;
                     sh:minCount    1 ;
                     sh:maxCount    1 ;
                     sh:message     "An origin-destination demand must have exactly one transport mode: car, truck or bicycle."@en ; ] ;
    sh:property    [ sh:path         ex:hour ;
                     sh:name         "hour"@en ;
                     sh:description  "Hour of the day (0-23)."@en ;
                     sh:datatype     xsd:integer ;
                     sh:minInclusive 0 ;
                     sh:maxInclusive 23 ;
                     sh:minCount     1 ;
                     sh:maxCount     1 ;
                     sh:message      "An origin-destination demand must have exactly one hour between 0 and 23."@en ; ] ;
    sh:property    [ sh:path         ex:demand ;
                     sh:name         "demand"@en ;
                     sh:description  "Demand between origin and destination."@en ;
                     sh:datatype     xsd:double ;
                     sh:minInclusive 0 ;
                     sh:minCount     1 ;
                     sh:maxCount     1 ;
                     sh:message      "An origin-destination demand must have exactly one non-negative demand."@en ; ] .


omg-shacl:RunConfigurationShape
    a                   sh:NodeShape ;
    rdfs:label          "Run configuration"@en ;
    dcterms:description "A key-value setting for a simulation run."@en ;
    sh:targetClass      ex:RunConfiguration ;
    sh:property         [ sh:path        ex:key ;
                          sh:name        "key"@en ;
                          sh:description "Name of the configuration setting."@en ;
                          sh:datatype    xsd:string ;
                          sh:minLength   1 ;
                          sh:minCount    1 ;
                          sh:maxCount    1 ;
                          sh:message     "A run configuration must have exactly one non-empty key."@en ; ] ;
    sh:property         [ sh:path        ex:value ;
                          sh:name        "value"@en ;
                          sh:description "Value of the configuration setting."@en ;
                          sh:datatype    xsd:string ;
                          sh:minCount    1 ;
                          sh:maxCount    1 ;
                          sh:message     "A run configuration must have exactly one value."@en ; ] ;
    sh:sparql           [ sh:message  "A run configuration key must be unique."@en ;
                          sh:prefixes <https://data.omgeving.vlaanderen.be/id/shacl/> ;
                          sh:select   """
            SELECT $this ?key
            WHERE {
                $this ex:key ?key .
                ?other a ex:RunConfiguration ;
                       ex:key ?key .
                FILTER (?other != $this)
            }
        """ ; ] .

omg-shacl:SimulationOutputShape
    a                   sh:NodeShape ;
    rdfs:label          "Simulation output"@en ;
    dcterms:description "The simulated traffic flow on a transport edge, for a transport mode and hour of the day."@en ;
    sh:targetClass      ex:TrafficFlowResult ;
    sh:property         [ sh:path        ex:transportEdge ;
                          sh:name        "transport edge"@en ;
                          sh:description "The transport edge the result applies to."@en ;
                          sh:class       ex:TransportEdge ;
                          sh:nodeKind    sh:BlankNodeOrIRI ;
                          sh:minCount    1 ;
                          sh:maxCount    1 ;
                          sh:message     "A traffic flow result must refer to exactly one transport edge."@en ; ] ;
    sh:property         [ sh:path        ex:transportMode ;
                          sh:name        "transport mode"@en ;
                          sh:description "The transport mode (matches the edge accessibility flags)."@en ;
                          sh:datatype    xsd:string ;
                          sh:in          ( "car" "truck" "bicycle" ) ;
                          sh:minCount    1 ;
                          sh:maxCount    1 ;
                          sh:message     "A traffic flow result must have exactly one transport mode: car, truck or bicycle."@en ; ] ;
    sh:property         [ sh:path         ex:hour ;
                          sh:name         "hour"@en ;
                          sh:description  "Hour of the day (0-23)."@en ;
                          sh:datatype     xsd:integer ;
                          sh:minInclusive 0 ;
                          sh:maxInclusive 23 ;
                          sh:minCount     1 ;
                          sh:maxCount     1 ;
                          sh:message      "A traffic flow result must have exactly one hour between 0 and 23."@en ; ] ;
    sh:property         [ sh:path         ex:flow ;
                          sh:name         "flow"@en ;
                          sh:description  "Simulated traffic flow."@en ;
                          sh:datatype     xsd:double ;
                          sh:minInclusive 0 ;
                          sh:minCount     1 ;
                          sh:maxCount     1 ;
                          sh:message      "A traffic flow result must have exactly one non-negative flow."@en ; ] .
