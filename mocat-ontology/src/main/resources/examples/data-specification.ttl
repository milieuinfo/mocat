@prefix omg-schema: <https://data.omgeving.vlaanderen.be/id/schema/> .
@prefix omg-shacl:  <https://data.omgeving.vlaanderen.be/id/shacl/> .
@prefix dcterms:    <http://purl.org/dc/terms/> .
@prefix rdf:        <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh:         <http://www.w3.org/ns/shacl#> .
@prefix xsd:        <http://www.w3.org/2001/XMLSchema#> .
@prefix geo:        <http://www.opengis.net/ont/geosparql#> .
@prefix p-plan:     <http://purl.org/net/p-plan#> .
@prefix ex:         <http://example.org/> .

# ── DataSpecification (p-plan:Variable) ──────────────────────────────────────

omg-schema:TransportNetworkSchema
    a                  p-plan:Variable ;
    dcterms:title      "Transport Network schema"@en ;
    dcterms:description "A transport network consists of vertices and edges."@en ;
    sh:node            omg-shacl:TransportNodeShape ;
    sh:node            omg-shacl:TransportEdgeShape .

# ── NodeShapes (sh:NodeShape) ─────────────────────────────────────────────────

omg-shacl:TransportNodeShape
    a              sh:NodeShape ;
    sh:name        "Transport node Schema"@en ;
    sh:description "A node (vertex) in the transport network."@en ;
    sh:targetClass ex:TransportNode ;
    sh:property    [ sh:path        ex:geom ;
                     sh:name        "geometry"@en ;
                     sh:description "Point geometry of the node."@en ;
                     sh:datatype    geo:wktLiteral ;
                     sh:minCount    1 ;
                     sh:maxCount    1 ;
                     sh:message     "A transport node must have exactly one (point) geometry." ; ] ;
    sh:sparql      [ sh:message "Each transport node must be connected to at least one transport edge." ;
                     sh:select  """
            SELECT ?this
            WHERE {
                FILTER NOT EXISTS { ?edge ex:fromNode ?this . }
                FILTER NOT EXISTS { ?edge ex:target ?this . }
            }
        """ ; ] .

omg-shacl:TransportEdgeShape
    a              sh:NodeShape ;
    sh:name        "Transport Edge Schema"@en ;
    sh:description "An edge (link) in the transport network."@en ;
    sh:targetClass ex:TransportEdge ;
    sh:property    [ sh:path        ex:length ;
                     sh:name        "length"@en ;
                     sh:description "Length of the edge in metres."@en ;
                     sh:datatype    xsd:double ;
                     sh:minCount    1 ;
                     sh:maxCount    1 ;
                     sh:message     "A transport edge must have exactly one length property." ; ] ;
    sh:property    [ sh:path        ex:fromNode ;
                     sh:name        "fromNode"@en ;
                     sh:description "Start node of the edge."@en ;
                     sh:class       ex:TransportNode ;
                     sh:minCount    1 ;
                     sh:maxCount    1 ;
                     sh:message     "A transport edge must have exactly one fromNode." ; ] ;
    sh:property    [ sh:path        ex:toNode ;
                     sh:name        "toNode"@en ;
                     sh:description "End node of the edge."@en ;
                     sh:class       ex:TransportNode ;
                     sh:minCount    1 ;
                     sh:maxCount    1 ;
                     sh:message     "A transport edge must have exactly one sink node." ; ] ;
    sh:property    [ sh:path        ex:legalSpeedLimit ;
                     sh:name        "speed limit"@en ;
                     sh:description "Legal speed limit."@en ;
                     sh:datatype    xsd:double ;
                     sh:minCount    1 ;
                     sh:maxCount    1 ;
                     sh:message     "A transport edge must have exactly one speed limit property." ; ] ;
    sh:property    [ sh:path        ex:carAccessible;
                     sh:name        "carAccessible"@en ;
                     sh:description "Whether the edge is car accessible."@en ;
                     sh:datatype    xsd:boolean ;
                     sh:minCount    1 ;
                     sh:maxCount    1 ;
                     sh:message     "A transport edge must have exactly one carAccessible property." ; ] ;
    sh:property    [ sh:path        ex:truckAccessible;
                     sh:name        "truckAccessible"@en ;
                     sh:description "Whether the edge is truck accessible."@en ;
                     sh:datatype    xsd:boolean ;
                     sh:minCount    1 ;
                     sh:maxCount    1 ;
                     sh:message     "A transport edge must have exactly one truckAccessible property." ; ] ;
    sh:property    [ sh:path        ex:bicycleAccessible;
                     sh:name        "bicycleAccessible"@en ;
                     sh:description "Whether the edge is bicycle accessible."@en ;
                     sh:datatype    xsd:boolean ;
                     sh:minCount    1 ;
                     sh:maxCount    1 ;
                     sh:message     "A transport edge must have exactly one bicycleAccessible property." ; ] ;
    sh:property    [ sh:path        ex:geom ;
                     sh:name        "geometry"@en ;
                     sh:description "Linestring geometry of the edge."@en ;
                     sh:datatype    geo:wktLiteral ;
                     sh:minCount    1 ;
                     sh:maxCount    1 ;
                     sh:message     "A transport edge must have exactly one (linestring) geometry." ; ] .


omg-shacl:TurnMovementShape
    a              sh:NodeShape ;
    sh:name        "Turn Movement Schema"@en ;
    sh:description "An indication that it is possible to make a turn, defined by 3 consecutive transport nodes, in the network."@en ;
    sh:targetClass ex:TransportEdge ;
    sh:property    [ sh:path        ex:length ;
                     sh:name        "length"@en ;
                     sh:description "Length of the edge in metres."@en ;
                     sh:datatype    xsd:double ;
                     sh:minCount    1 ;
                     sh:maxCount    1 ;
                     sh:message     "A transport edge must have exactly one length property." ; ] ;
    sh:property    [ sh:path        ex:fromNode ;
                     sh:name        "fromNode"@en ;
                     sh:description "Start node of the turn movement."@en ;
                     sh:class       ex:TransportNode ;
                     sh:minCount    1 ;
                     sh:maxCount    1 ;
                     sh:message     "A turn movement must have exactly one fromNode." ; ] ;
    sh:property    [ sh:path        ex:viaNode ;
                     sh:name        "viaNode"@en ;
                     sh:description "Via node of the edge."@en ;
                     sh:class       ex:TransportNode ;
                     sh:minCount    1 ;
                     sh:maxCount    1 ;
                     sh:message     "A turn movement must have exactly one viaNode." ; ] ;
    sh:property    [ sh:path        ex:toNode ;
                     sh:name        "toNode"@en ;
                     sh:description "End node of the edge."@en ;
                     sh:class       ex:TransportNode ;
                     sh:minCount    1 ;
                     sh:maxCount    1 ;
                     sh:message     "A turn movement must have exactly one sink node." ; ] ;
    sh:property    [ sh:path        ex:geom ;
                     sh:name        "geometry"@en ;
                     sh:description "Linestring geometry of the edge."@en ;
                     sh:datatype    geo:wktLiteral ;
                     sh:minCount    1 ;
                     sh:maxCount    1 ;
                     sh:message     "A transport edge must have exactly one (linestring) geometry." ; ] ;
    sh:sparql      [ sh:message "The fromNode-viaNode must correspond to an edge in the transport network." ;
                     sh:select  """
            SELECT ?fromNode ?viaNode
            WHERE {
                FILTER NOT EXISTS { ?edge ex:fromNode ?fromNode .
                                    ?edge ex:toNode ?viaNode .
                                    ?edge a ex:TransportEdge .
                                    ?}
            }
        """ ; ]  ;
    sh:sparql      [ sh:message "The viaNode-toNode must correspond to an edge in the transport network." ;
                     sh:select  """
            SELECT ?fromNode ?viaNode
            WHERE {
                FILTER NOT EXISTS { ?edge ex:fromNode ?viaNode .
                                    ?edge ex:toNode ?toNode .
                                    ?edge a ex:TransportEdge .
                                    ?}
            }
        """ ; ] .

# TODO
omg-shacl:TransportZoneShape
    a              sh:NodeShape ;
    sh:name        "Transport zone"@en ;
    sh:description "The spatial limits of the transport zone for which the simulation model can produce valid results."@en ;
    sh:targetClass ex:TransportZone .

