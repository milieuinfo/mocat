omg-dataset:xcite-kortrijk-network
    a                            dcat:Dataset ;
    dcterms:title                "xCite Kortrijk Transport network"@en ;
    dcterms:description          """This dataset contains a routable transport network
that was derived from OpenStreetMap data and extended with traffic-light control schemes and local information."""@en ;
    dcat:keyword                 "transport network"@en, "OpenStreetMap"@en ;
    dcat:theme                   <http://publications.europa.eu/resource/authority/data-theme/TRAN> ;
    dcat:theme                   <http://www.eionet.europa.eu/gemet/concept/11087> ;
    dcat:theme                   <http://www.eionet.europa.eu/gemet/concept/7702> ;
    dcterms:publisher            ex:OMG ;
    dcterms:issued               "2024-01-01"^^xsd:date ;
    dcterms:modified             "2026-06-01"^^xsd:date ;
    dcat:distribution            omg-distribution:xcite-kortrijk-network-geojson ;
    dcterms:conformsTo           omg-schema:TransportNetworkSchema ;
    p-plan:correspondsToVariable omg-schema:TransportNetworkSchema ;
    prov:wasDerivedFrom          omg-dataset:osm_raw_dataset .

